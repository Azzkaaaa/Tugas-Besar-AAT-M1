# Template variables for services/envoy/templates (rendered by docker-entrypoint.sh).
# Compose sets the same values; this file feeds the nx render/validate targets.
ENVOY_LISTEN_PORT=8080
ENVOY_HEALTH_PATH=/healthz
APP_HOST=localhost
APP_ORIGIN=http://localhost:8080
AUTH_HOST=auth.localhost
AUTH_ROUTE_PREFIX=/auth/
API_ROUTE_PREFIX=/api/
LOGIN_UI_ROUTE_PREFIX=/ui/v2/login
ZITADEL_ADDRESS=zitadel
ZITADEL_PORT=8080
ZITADEL_LOGIN_ADDRESS=zitadel-login
ZITADEL_LOGIN_PORT=3000
AUTH_BRIDGE_ADDRESS=auth-bridge
AUTH_BRIDGE_PORT=3001
SPA_ADDRESS=spa-server
SPA_PORT=80
API_GATEWAY_ADDRESS=api-gateway
API_GATEWAY_PORT=8080
OTEL_COLLECTOR_ADDRESS=otel-lgtm
OTEL_COLLECTOR_GRPC_PORT=4317
TOKEN_EXCHANGE_URL=auth.localhost:8080/oauth/v2/token
AUTH_ACCESS_COOKIE=bnpb_access
AUTH_COOKIE_PREFIX=bnpb_
# Development escape hatch: when true, a request carrying TRACE_ESCAPE_HATCH_HEADER gets its
# x-trace-id back. Keep false anywhere but a local stack.
TRACE_ESCAPE_HATCH_ENABLED=false
TRACE_ESCAPE_HATCH_HEADER=x-bnpb-trace-debug
# Normally read from the auth_client_config volume (oidc.json); placeholders for render/validate only.
TOKEN_EXCHANGE_CLIENT_ID=REPLACE_FROM_OIDC_JSON
TOKEN_EXCHANGE_CLIENT_SECRET=REPLACE_FROM_OIDC_JSON
