{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "frontend",
  "projectType": "application",
  "sourceRoot": "services/frontend/src",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": { "command": "npm ci", "cwd": "services/frontend" },
      "cache": false
    },
    "dev": {
      "dependsOn": ["install"],
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "services/frontend" }
    },
    "compile": {
      "dependsOn": ["install"],
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "services/frontend" },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/node_modules/**/*",
        "!{projectRoot}/dist/**/*",
        "!{projectRoot}/playwright-report/**/*",
        "!{projectRoot}/test-results/**/*",
        { "env": "VITE_APP_MODE" },
        { "env": "VITE_ENABLE_DEMO" },
        { "env": "VITE_API_BASE_URL" }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "dependsOn": ["install"],
      "executor": "nx:run-commands",
      "options": { "command": "npm test", "cwd": "services/frontend" }
    },
    "test-e2e": {
      "dependsOn": ["install"],
      "executor": "nx:run-commands",
      "options": { "command": "npm run test:e2e", "cwd": "services/frontend" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "docker buildx build --push -f services/frontend/Dockerfile -t \"$PROJECT_IMAGE_REMOTE/frontend:$(git rev-parse HEAD)\" -t bnpb/frontend .", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "scan-fs": {},
    "scan-image": {}
  }
}
