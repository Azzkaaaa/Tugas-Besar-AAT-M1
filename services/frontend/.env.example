# Public browser configuration only. Never put passwords, API keys, or
# BMKG/PVMBG service secrets in VITE_* variables.
# The dev server permits demo mode; production builds also require
# VITE_ENABLE_DEMO=true before simulated access is available.
VITE_APP_MODE=demo
VITE_ENABLE_DEMO=false
VITE_DATA_MODE=mock
VITE_API_BASE_URL=/api/v1

# Integrated deployments use VITE_APP_MODE=oidc. Authentication then always
# goes through /auth/* on the SPA origin, regardless of VITE_DATA_MODE.
# Use VITE_DATA_MODE=gateway when the business API is ready.
