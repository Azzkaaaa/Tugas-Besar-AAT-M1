{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "token-exchange",
  "projectType": "application",
  "sourceRoot": "services/token-exchange/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo build --release --locked", "cwd": "services/token-exchange" },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/Cargo.toml", "{projectRoot}/Cargo.lock"],
      "outputs": ["{projectRoot}/target/release/token-exchange"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "cargo test --locked", "cwd": "services/token-exchange" },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/Cargo.toml", "{projectRoot}/Cargo.lock"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cargo fmt --check", "cargo clippy --all-targets --locked -- -D warnings"],
        "parallel": false,
        "cwd": "services/token-exchange"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/Cargo.toml", "{projectRoot}/Cargo.lock", "{projectRoot}/rustfmt.toml"]
    },
    "docker": {
      "executor": "nx:run-commands",
      "options": { "command": "docker build -t bnpb/token-exchange services/token-exchange", "cwd": "{workspaceRoot}" },
      "cache": false
    }
  }
}
