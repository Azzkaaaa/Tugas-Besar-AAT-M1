{
  "uid": "bnpb-health-traces",
  "title": "BNPB Health & Traces",
  "tags": [
    "bnpb",
    "health",
    "tracing"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Health (blackbox_exporter probes)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "state-timeline",
      "title": "Service health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "probe_success per service: gRPC health, HTTP /health, or TCP connect (services/blackbox).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (service) (probe_success)",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Services down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(max by (service) (probe_success) == 0) or vector(0)",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Probe duration",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (service) (probe_duration_seconds)",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Requests (server spans, from Tempo span metrics)",
      "collapsed": false,
      "panels": [],
      "id": 5,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Error ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      }
    },
    {
      "type": "row",
      "title": "Dependencies and outgoing calls",
      "collapsed": false,
      "panels": [],
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service map",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Tempo service graph. Nodes without their own spans (mocks, Postgres, FCM) come from server.address / db attributes.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "serviceMap"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Outgoing p95 per edge",
      "description": "Caller-side latency; alert \"Slow outgoing calls\" fires above 2 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (client, server, le) (rate(traces_service_graph_request_client_seconds_bucket{client!=\"user\"}[$__rate_interval])))",
          "legendFormat": "{{client}} → {{server}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 35
      }
    },
    {
      "type": "timeseries",
      "title": "Failed outgoing calls",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total{client!=\"user\"}[$__rate_interval]))",
          "legendFormat": "{{client}} → {{server}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 35
      }
    },
    {
      "type": "timeseries",
      "title": "Outgoing p95 by target host (client spans)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, server_address, le) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_CLIENT\", server_address!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{service}} → {{server_address}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 44
      }
    },
    {
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "panels": [],
      "id": 14,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 53
      }
    },
    {
      "type": "table",
      "title": "Recent error traces",
      "description": "Click a trace ID to open it in Tempo.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 54
      }
    },
    {
      "type": "table",
      "title": "Slow traces (> 1 s)",
      "description": "Long requests across all services.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ duration > 1s }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 54
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
