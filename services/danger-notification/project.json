{
  "name": "danger-notification",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/danger-notification",
  "implicitDependencies": [
    "bnpb-aggregator-dotnet",
    "bnpb-event-dotnet",
    "bnpb-notification-dotnet"
  ],
  "targets": {
    "compile": {
      "dependsOn": [
        "^compile"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/.gitignore",
        "!{projectRoot}/Dockerfile",
        "!{projectRoot}/README.md",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/**/bin/**/*",
        "{projectRoot}/**/obj/**/*"
      ]
    },
    "test": {
      "dependsOn": [
        "compile"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^compile"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build --push -f services/danger-notification/Dockerfile -t \"$PROJECT_IMAGE_REMOTE/danger-notification:$(git rev-parse HEAD)\" -t bnpb/danger-notification .",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "scan-fs": {},
    "scan-image": {}
  }
}
