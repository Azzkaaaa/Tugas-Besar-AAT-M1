{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:9095"
      }
    }
  },
  "RabbitMq": {
    "HostName": "",
    "UserName": "",
    "Password": "",
    "QueueName": ""
  },
  "Fcm": {
    "Topic": "hazard-alerts"
  },
  "Aggregator": {
    "Address": "http://aggregator:9091"
  },
  "Auth": {
    "Authority": "",
    "RequireHttpsMetadata": true,
    "ScopeClaim": "scope"
  }
}
