{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:9095"
      }
    }
  },
  "RabbitMq": {
    "HostName": "",
    "UserName": "",
    "Password": "",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "",
    "QueueName": "",
    "DeadLetterQueue": ""
  },
  "ConnectionStrings": {
    "Notifications": "Data Source=notifications.db"
  },
  "Persistence": {
    "Provider": "sqlite"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 10,
    "MaxAttempts": 5,
    "BaseBackoff": "00:00:05",
    "LeaseDuration": "00:01:00"
  },
  "Fcm": {
    "Topic": "hazard-alerts"
  },
  "Aggregator": {
    "Address": "http://aggregator:9091"
  },
  "Auth": {
    "Authority": "",
    "RequireHttpsMetadata": true,
    "ScopeClaim": "scopes"
  }
}
