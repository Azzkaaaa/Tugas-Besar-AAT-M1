{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bmkg-mock",
  "projectType": "application",
  "sourceRoot": "services/bmkg-mock",
  "targets": {
    "compile": {
      "dependsOn": ["^compile"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/contracts/openapi/bmkg.yaml",
        "{projectRoot}/**/*.py"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "python3 -m unittest discover -p 'test_*.py'", "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.py"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "ruff check .", "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.py", "{workspaceRoot}/ruff.toml"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "docker buildx build --push -f services/bmkg-mock/Dockerfile -t \"$PROJECT_IMAGE_REMOTE/bmkg-mock:$(git rev-parse HEAD)\" -t bnpb/bmkg-mock .", "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "scan-fs": {},
    "scan-image": {}
  }
}
