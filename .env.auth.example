# Local Auth stack. Run python tools/setup_auth_env.py to create .env.auth.
# These are placeholders, never deploy or commit generated values.
ZITADEL_MASTERKEY=REPLACE_GENERATED_32_CHAR_KEY
AUTH_POSTGRES_PASSWORD=REPLACE_GENERATED_PASSWORD
LOGIN_SESSION_COOKIE_SECRET=REPLACE_GENERATED_SECRET
AUTH_SESSION_KEY=REPLACE_GENERATED_64_HEX_KEY
AUTH_ADMIN_PASSWORD=REPLACE_GENERATED_PASSWORD
AUTH_MEDIA_PASSWORD=REPLACE_GENERATED_PASSWORD
AUTH_FIELD_TEAM_PASSWORD=REPLACE_GENERATED_PASSWORD
AUTH_BNPB_PASSWORD=REPLACE_GENERATED_PASSWORD
# Short-lived access tokens as required by M1; refresh/session lifetime is 24 hours.
ZITADEL_ACCESS_TOKEN_TTL_SECONDS=60
AUTH_SESSION_TTL_SECONDS=86400
# Keep mock data until the BNPB API is available. Authentication is real OIDC.
FRONTEND_DATA_MODE=mock
# Development only: when true, Envoy returns x-trace-id to requests that send the
# x-bnpb-trace-debug header. Never enable outside a local stack.
TRACE_ESCAPE_HATCH_ENABLED=false
