{
  "name": "bnpb-notification-dotnet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/bnpb-notification-dotnet",
  "implicitDependencies": ["bnpb-common-dotnet"],
  "targets": {
    "clean-proto": {
      "executor": "nx:run-commands",
      "options": {
        "command": "git clean -fdX {projectRoot}",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "generate-proto": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf generate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/buf.gen.yaml",
        "{projectRoot}/**/*.csproj",
        "{workspaceRoot}/contracts/proto/bnpb/notification/**/*.proto"
      ],
      "outputs": [
        "{projectRoot}/BNPB.Notification/codegen/**/*",
        "!{projectRoot}/BNPB.Notification/codegen/.gitignore"
      ]
    },
    "clean": {
      "dependsOn": ["clean-proto"]
    },
    "compile": {
      "dependsOn": ["^compile", "generate-proto"]
    }
  }
}
