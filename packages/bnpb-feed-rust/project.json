{
  "name": "bnpb-feed-rust",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/bnpb-feed-rust",
  "implicitDependencies": [
    "bnpb-common-rust"
  ],
  "targets": {
    "clean-proto": {
      "executor": "nx:run-commands",
      "options": {
        "command": "git clean -fdX {projectRoot}",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "generate-proto": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf generate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/buf.gen.yaml",
        "{projectRoot}/**/Cargo.toml",
        "{workspaceRoot}/contracts/proto/bnpb/feed/**/*.proto"
      ],
      "outputs": [
        "{projectRoot}/bnpb-feed/codegen/**/*",
        "!{projectRoot}/bnpb-feed/codegen/.gitignore"
      ]
    },
    "clean": {
      "dependsOn": [
        "clean-proto"
      ]
    },
    "compile": {
      "dependsOn": [
        "^compile",
        "generate-proto"
      ]
    }
  }
}
