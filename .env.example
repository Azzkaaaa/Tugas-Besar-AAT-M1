# Auth uses .env.auth.example and tools/setup_auth_env.py (OIDC, cookies, sessions).
# Copy to .env; replace each REPLACE_* placeholder with an independent secret.
# Never inject the entire .env into every service; select variables per owner.
APP_ENV=development
LOG_LEVEL=info
BMKG_HTTP_PORT=8081
PVMBG_HTTP_PORT=8082
AGGREGATOR_GRPC_PORT=9091
EVENT_FEED_GRPC_PORT=9093
WEBHOOK_GRPC_PORT=9094
NOTIFICATION_GRPC_PORT=9095
BMKG_BASE_URL=http://bmkg-mock:8080
PVMBG_BASE_URL=http://pvmbg-mock:8080
# Compose service names. api-gateway calls all four; Danger Notification also
# calls the aggregator.
AGGREGATOR_GRPC_ADDRESS=aggregator-service:9091
EVENT_FEED_GRPC_ADDRESS=feed-service:9093
WEBHOOK_GRPC_ADDRESS=webhook-provider:9094
NOTIFICATION_GRPC_ADDRESS=notification-service:9095

# Auth: OIDC issuer whose /.well-known/openid-configuration publishes JWKS.
# Aggregator and Webhook Provider validate JWT signatures against the keys from
# this endpoint (Compose passes each as AUTH_AUTHORITY).
# Set AUTH_INSECURE_SKIP_VERIFY=true ONLY for local dev (skips signature check).
AGGREGATOR_AUTH_AUTHORITY=http://auth.localhost:8080
WEBHOOK_AUTH_AUTHORITY=http://auth.localhost:8080
AUTH_AUDIENCE=
AUTH_INSECURE_SKIP_VERIFY=false

# External trust domains: do not reuse any of these values.
BMKG_API_KEY=REPLACE_BMKG_ONLY
PVMBG_BEARER_TOKEN=REPLACE_PVMBG_ONLY

# Separate credentials for internal callers (x-service-token metadata).
# Each service gets only its own token.
AGGREGATOR_SERVICE_TOKEN=REPLACE_AGGREGATOR_SERVICE_TOKEN
WEBHOOK_SERVICE_TOKEN=REPLACE_WEBHOOK_SERVICE_TOKEN

# Danger Notification (.NET). Compose maps these onto appsettings.json keys
# (Section__Key); see docs/configuration.md. Broker credentials, exchange and
# queues come from the RabbitMQ section below. An empty authority falls back to
# the local Zitadel (http://auth.localhost:8080). The Firebase service-account
# JSON is mounted read-only; danger-notification fails to start until this file
# exists.
NOTIFICATION_AUTH_AUTHORITY=
NOTIFICATION_AUTH_REQUIRE_HTTPS_METADATA=false
NOTIFICATION_AUTH_SCOPE_CLAIM=scopes
NOTIFICATION_RABBITMQ_HOST=rabbitmq
NOTIFICATION_RABBITMQ_PORT=5672
NOTIFICATION_FCM_TOPIC=hazard-alerts
# Postgres store + push outbox (compose service notification-db). Compose
# builds the connection string; outside compose set
# ConnectionStrings__Notifications and Persistence__Provider=postgres, or leave
# both unset for a local SQLite file (single replica).
NOTIFICATION_DB_PASSWORD=
FIREBASE_CREDENTIALS_PATH=./.secrets/firebase-credentials.json

# Firebase web app for browser push (same Firebase project as the credentials
# above). These are public identifiers baked into the SPA bundle at build time;
# leave any of them empty to build without push. VAPID is the public Web Push
# certificate key from Project settings > Cloud Messaging.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Frontend. FRONTEND_API_BASE_URL is baked into the compose.yaml SPA build;
# FRONTEND_HTTP_PORT is the host port of the compose.frontend.yaml preview.
FRONTEND_API_BASE_URL=/api/v1
FRONTEND_HTTP_PORT=5173

# Mock behavior / ingest. Validation must enforce specification bounds.
MOCK_SEED_COUNT=20
MOCK_EVENT_INTERVAL_MS=10000
BMKG_RESPONSE_DELAY_MS=100
PVMBG_RESPONSE_DELAY_MIN_MS=500
PVMBG_RESPONSE_DELAY_MAX_MS=3000
BMKG_POLL_INTERVAL_MS=3000
PVMBG_POLL_INTERVAL_MS=3000
BMKG_REQUEST_TIMEOUT_MS=1000
PVMBG_REQUEST_TIMEOUT_MS=3500
SOURCE_STALE_AFTER_MS=10000
GATEWAY_REQUEST_TIMEOUT_MS=2000
GATEWAY_MAX_IN_FLIGHT=100
GATEWAY_RETRY_AFTER_SECONDS=5
GATEWAY_SSE_HEARTBEAT_SECONDS=15
FEED_REPLAY_RETENTION_SECONDS=600
FEED_REPLAY_MAX_ENTRIES=10000
# Compose points FEED_REDIS_URL at its own feed-redis service. Unset, the replay
# buffer lives in process memory (single replica).
FEED_REDIS_URL=
# Event Live Feed token rotation. The client ID/secret default to feed_client_id/secret
# in the oidc.json written by auth-bootstrap; set these only to override them.
FEED_AUTH_AUTHORITY=http://auth.localhost:8080
FEED_TOKEN_EXCHANGE_CLIENT_ID=
FEED_TOKEN_EXCHANGE_CLIENT_SECRET=
FEED_TOKEN_RENEW_BEFORE_SECONDS=15
FEED_MAX_STREAM_SECONDS=3600
WEBHOOK_MAX_RETRIES=5
WEBHOOK_HTTP_TIMEOUT_MS=10000

# Storage. Mock SQLite paths are relative to the repository root locally and to
# /app inside each mock's private /app/data volume.
BMKG_STORE_DSN=sqlite:///data/bmkg.sqlite3
PVMBG_STORE_DSN=sqlite:///data/pvmbg.sqlite3
AGGREGATOR_DB_PASSWORD=
# Webhook Provider: compose builds WEBHOOK_STORE_DSN for webhook-db from this
# password and points WEBHOOK_REDIS_URL at its own webhook-redis service. Outside
# compose set WEBHOOK_STORE_DSN (postgres://... or a SQLite path such as
# file:webhook.db) and optionally WEBHOOK_REDIS_URL; without Redis, delivery
# dedup is per process (single replica).
WEBHOOK_DB_PASSWORD=
WEBHOOK_DEDUP_TTL_HOURS=168

# RabbitMQ initialization
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=vhost
# Compose provisions only the RABBITMQ_DEFAULT_* account, so every service
# shares it locally. Compose builds the Event Live Feed URL and the Danger
# Notification settings from these parts.
AGGREGATOR_AMQP_URL=amqp://guest:guest@rabbitmq:5672/vhost
WEBHOOK_AMQP_URL=amqp://guest:guest@rabbitmq:5672/vhost

RABBITMQ_EXCHANGE=bnpb.hazards.v1

# Each consumer declares and binds its own queue and dead-letter queue.
EVENT_FEED_CONSUMER_QUEUE=bnpb.event-live-feed.v1
EVENT_FEED_CONSUMER_DLQ=bnpb.event-live-feed.dlq.v1

WEBHOOK_CONSUMER_QUEUE=bnpb.webhook-provider.v1
WEBHOOK_CONSUMER_DLQ=bnpb.webhook-provider.dlq.v1

NOTIFICATION_CONSUMER_QUEUE=bnpb.danger-notification.v1
NOTIFICATION_CONSUMER_DLQ=bnpb.danger-notification.dlq.v1

OUTBOX_MAX_RETRIES=5

# Observability endpoints (otel-lgtm or OpenTelemetry Collector)
# HTTP protobuf exporter: http://otel-lgtm:4318 (protocol: http/protobuf)
# gRPC exporter: otel-lgtm:4317 (protocol: grpc)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=REPLACE_WITH_SERVICE_NAME
# Development only: when true, Envoy returns x-trace-id to requests that send the
# x-bnpb-trace-debug header, so a request can be looked up in Grafana. Responses carry no trace
# identifiers otherwise, and client-supplied trace context is always dropped at the edge.
TRACE_ESCAPE_HATCH_ENABLED=false
