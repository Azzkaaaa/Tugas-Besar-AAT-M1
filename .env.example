# Reserved documentation viewer configuration
API_DOCS_PORT=8090

# BMKG/PVMBG settings are implemented. Business BNPB settings remain planned.
# Auth uses .env.auth.example and tools/setup_auth_env.py (OIDC, cookies, sessions).
# Copy to .env; replace each REPLACE_* placeholder with an independent secret.
# Never inject the entire .env into every service; select variables per owner.
APP_ENV=development
LOG_LEVEL=info
GATEWAY_HTTP_PORT=8080
BMKG_HTTP_PORT=8081
PVMBG_HTTP_PORT=8082
AGGREGATOR_GRPC_PORT=9091
EVENT_FEED_GRPC_PORT=9093
WEBHOOK_GRPC_PORT=9094
NOTIFICATION_GRPC_PORT=9095
BMKG_BASE_URL=http://bmkg-mock:8080
PVMBG_BASE_URL=http://pvmbg-mock:8080
AGGREGATOR_GRPC_ADDRESS=aggregator:9091
EVENT_FEED_GRPC_ADDRESS=event-live-feed:9093
WEBHOOK_GRPC_ADDRESS=webhook-provider:9094
NOTIFICATION_GRPC_ADDRESS=danger-notification:9095

AUTH_PUBLIC_KEY=
AUTH_PUBLIC_KEY_PATH=

# External trust domains: do not reuse any of these values.
BMKG_API_KEY=REPLACE_BMKG_ONLY
PVMBG_BEARER_TOKEN=REPLACE_PVMBG_ONLY

# Separate credentials for internal callers (x-service-token metadata).
# Each receiver must validate the allowlist; each caller gets only its own token.
AGGREGATOR_SERVICE_TOKEN=REPLACE_AGGREGATOR_SERVICE_TOKEN
EVENT_FEED_SERVICE_TOKEN=REPLACE_EVENT_FEED_SERVICE_TOKEN
WEBHOOK_SERVICE_TOKEN=REPLACE_WEBHOOK_SERVICE_TOKEN
NOTIFICATION_SERVICE_TOKEN=REPLACE_NOTIFICATION_SERVICE_TOKEN

# Danger Notification external dependencies. An empty authority falls back to
# the local Zitadel (http://auth.localhost:8080). The Firebase service-account
# JSON is mounted read-only; danger-notification fails to start until this file
# exists.
NOTIFICATION_AUTH_AUTHORITY=
FIREBASE_CREDENTIALS_PATH=./.secrets/firebase-credentials.json

# Mock behavior / ingest. Validation must enforce specification bounds.
MOCK_SEED_COUNT=20
MOCK_EVENT_INTERVAL_MS=10000
BMKG_RESPONSE_DELAY_MS=100
PVMBG_RESPONSE_DELAY_MIN_MS=500
PVMBG_RESPONSE_DELAY_MAX_MS=3000
BMKG_POLL_INTERVAL_MS=3000
PVMBG_POLL_INTERVAL_MS=3000
BMKG_REQUEST_TIMEOUT_MS=1000
PVMBG_REQUEST_TIMEOUT_MS=3500
SOURCE_STALE_AFTER_MS=10000
GATEWAY_REQUEST_TIMEOUT_MS=2000
GATEWAY_MAX_IN_FLIGHT=100
FEED_REPLAY_RETENTION_SECONDS=600
PAGE_TOKEN_TTL_SECONDS=300

# SQLite paths for local mocks, relative to the repository root.
# Compose fixes each path in its private /app/data volume.
# Other services' storage choices remain undecided.
BMKG_STORE_DSN=sqlite:///data/bmkg.sqlite3
PVMBG_STORE_DSN=sqlite:///data/pvmbg.sqlite3
CANONICAL_STORE_DSN=postgres://aggregator:postgres@aggregator-db.local:5432/bnpb_canonical?sslmode=disable
AUTH_STORE_DSN=
AUTH_CACHE_DSN=
NOTIFICATION_STORE_DSN=
EVENT_FEED_CACHE_DSN=
WEBHOOK_STORE_DSN=file:/data/webhook.db

# RabbitMQ initialization
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=vhost
AGGREGATOR_AMQP_URL=amqp://guest:guest@rabbitmq:5672/vhost

# kayaknya gk perlu different creds per client deh
# ribet :v
EVENT_FEED_AMQP_URL=amqp://event-feed:REPLACE_FEED_BROKER_SECRET@rabbitmq:5672/bnpb
WEBHOOK_AMQP_URL=amqp://webhook-provider:REPLACE_WEBHOOK_BROKER_SECRET@rabbitmq:5672/bnpb
NOTIFICATION_AMQP_URL=amqp://notifier:REPLACE_NOTIFIER_BROKER_SECRET@rabbitmq:5672/bnpb

RABBITMQ_EXCHANGE=bnpb.hazards.v1

CONSUMER_1_NAME=event-live-feed
CONSUMER_1_QUEUE=bnpb.event-live-feed.v1
CONSUMER_1_DLQ=bnpb.event-live-feed.dlq.v1

CONSUMER_2_NAME=webhook-provider
CONSUMER_2_QUEUE=bnpb.webhook-provider.v1
CONSUMER_2_DLQ=bnpb.webhook-provider.dlq.v1

CONSUMER_3_NAME=danger-notification
CONSUMER_3_QUEUE=bnpb.danger-notification.v1
CONSUMER_3_DLQ=bnpb.danger-notification.dlq.v1

OUTBOX_MAX_RETRIES=5

# Observability endpoints (otel-lgtm or OpenTelemetry Collector)
# HTTP protobuf exporter: http://otel-lgtm:4318 (protocol: http/protobuf)
# gRPC exporter: otel-lgtm:4317 (protocol: grpc)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=REPLACE_WITH_SERVICE_NAME
